# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session signing secret for email/password JWT tokens (optional; falls back to runtime ephemeral secret if unset).
SESSION_SECRET=

# Platform Owner email (automatically granted Owner privileges on sign-in).
OWNER_EMAIL="dataexperts254@gmail.com"

# Safaricom Daraja M-Pesa API Credentials (KES Transactions)
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=

# Optional Exchange Rate Feed URL (USD -> KES)
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest/USD"
